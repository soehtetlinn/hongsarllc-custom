<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="purchase_order_form_product_visible_company" model="ir.ui.view">
        <field name="name">purchase.order.form.product.visible.company</field>
        <field name="model">purchase.order</field>
        <field name="priority">1000</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/list//field[@name='product_id'][@widget='product_label_section_and_note_field']"
                position="attributes">
                <attribute name="domain">[('purchase_ok', '=', True), '|', ('product_tmpl_id.x_studio_visible_company', '=', False), ('product_tmpl_id.x_studio_visible_company', '=', parent.company_id)]</attribute>
                <attribute name="context">{
                    'partner_id': parent.partner_id,
                    'quantity': product_qty,
                    'company_id': parent.company_id,
                    'hongsar_order_by_internal_ref': 1,
                }</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_id'][@widget='many2one_barcode']"
                position="attributes">
                <attribute name="domain">['&amp;', '&amp;', ('purchase_ok', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id), '|', ('product_tmpl_id.x_studio_visible_company', '=', False), ('product_tmpl_id.x_studio_visible_company', '=', parent.company_id)]</attribute>
                <attribute name="context">{
                    'partner_id': parent.partner_id,
                    'hongsar_order_by_internal_ref': 1,
                }</attribute>
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/kanban//field[@name='product_id'][@class='fw-bold col-8']"
                position="attributes">
                <attribute name="options">{'no_create': True, 'no_create_edit': True}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
