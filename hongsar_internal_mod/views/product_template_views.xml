<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_other_name" model="ir.ui.view">
        <field name="name">product.template.form.other.name</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title']/h1" position="after">
                <label for="product_other_name" string="Product (Other Name)"/>
                <h1>
                    <field class="text-break" name="product_other_name" options="{'line_breaks': False}" widget="text" placeholder="Alternative Product Name"/>
                </h1>
            </xpath>
        </field>
    </record>
</odoo>
