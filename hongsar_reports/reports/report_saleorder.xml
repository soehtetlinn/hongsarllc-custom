<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_hongsar">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="hongsar_reports.formal_external_layout">
                    <div class="formal-report-page">
                        <h2 class="doc-title">
                            <t t-if="o.state in ['draft', 'sent']">Quotation</t>
                            <t t-else="">Sales Order</t>
                        </h2>

                        <table class="meta-table">
                            <tr>
                                <td><strong>Quotation #</strong> <span t-field="o.name"/></td>
                                <td><strong>Date:</strong> <span t-field="o.date_order"/></td>
                            </tr>
                            <tr>
                                <td><strong>Customer Ref:</strong> <span t-out="o.client_order_ref or '-'"/></td>
                                <td><strong>Salesperson:</strong> <span t-out="o.user_id.name or '-'"/></td>
                            </tr>
                        </table>

                        <table class="grid-table classic-grid">
                            <thead>
                                <tr>
                                    <th class="col-no">No.</th>
                                    <th>Description</th>
                                    <th class="col-other">Other Name</th>
                                    <th class="col-qty">Qty</th>
                                    <th class="col-pkgqty">Pkg Qty</th>
                                    <th class="col-pkg">Package</th>
                                    <th class="col-price">Unit Price</th>
                                    <th class="col-amt">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="lines" t-value="o.order_line.filtered(lambda l: not l.display_type or l.display_type in ('line_section', 'line_note'))"/>
                                <t t-set="p_idx" t-value="1"/>
                                <tr t-foreach="lines" t-as="line" t-att-class="'fw-bold o_line_section' if line.display_type == 'line_section' else 'fst-italic o_line_note' if line.display_type == 'line_note' else ''">
                                    <t t-if="not line.display_type">
                                        <td class="text-center"><span t-out="p_idx"/></td>
                                        <td><span t-field="line.name"/></td>
                                        <td>
                                            <span t-out="line.product_id.product_tmpl_id.product_other_name or '-'"/>
                                        </td>
                                        <td class="text-end"><span t-field="line.product_uom_qty"/></td>
                                        <td class="text-end">
                                            <span t-if="line.product_packaging_qty" t-field="line.product_packaging_qty"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td>
                                            <span t-if="line.product_packaging_id" t-field="line.product_packaging_id"/>
                                            <span t-else="">-</span>
                                        </td>
                                        <td class="text-end"><span t-field="line.price_unit"/></td>
                                        <td class="text-end"><span t-field="line.price_subtotal"/></td>
                                        <t t-set="p_idx" t-value="p_idx + 1"/>
                                    </t>
                                    <t t-elif="line.display_type == 'line_section'">
                                        <td colspan="8" style="background-color: #f6f9ff; padding-left: 10px;">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <td colspan="8" style="color: #000000; padding-left: 20px;">
                                            <span t-field="line.name" t-options="{'widget': 'text'}"/>
                                        </td>
                                    </t>
                                </tr>
                            </tbody>
                        </table>

                        <table class="totals-table">
                            <tr>
                                <td>Subtotal</td>
                                <td class="text-end"><span t-field="o.amount_untaxed"/></td>
                            </tr>
                            <tr>
                                <td>Taxes</td>
                                <td class="text-end"><span t-field="o.amount_tax"/></td>
                            </tr>
                            <tr class="grand-total">
                                <td><strong>Total</strong></td>
                                <td class="text-end"><strong><span t-field="o.amount_total"/></strong></td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
