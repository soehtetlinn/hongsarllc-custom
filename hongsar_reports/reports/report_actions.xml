<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="action_report_saleorder_hongsar" model="ir.actions.report">
            <field name="name">Hongsar Sales Order</field>
            <field name="model">sale.order</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hongsar_reports.report_saleorder_document_hongsar</field>
            <field name="report_file">hongsar_reports.report_saleorder_document_hongsar</field>
            <field name="paperformat_id" ref="hongsar_reports.paperformat_hongsar_formal"/>
            <field name="print_report_name">'SO - %s' % (object.name)</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_type">report</field>
        </record>

        <record id="action_report_invoice_hongsar" model="ir.actions.report">
            <field name="name">Hongsar Invoice</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="report_file">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="paperformat_id" ref="hongsar_reports.paperformat_hongsar_formal"/>
            <field name="print_report_name">'INV - %s' % (object.name)</field>
            <field name="binding_model_id" ref="account.model_account_move"/>
            <field name="binding_type">report</field>
            <field name="domain" eval="[('move_type', 'in', ('out_invoice', 'out_refund'))]"/>
            <field name="groups_id" eval="[(4, ref('account.group_account_invoice')), (4, ref('account.group_account_readonly'))]"/>
        </record>

        <!-- Also remap default account invoice print actions to avoid routing to
             account.report_invoice/account.report_invoice_with_payments -->
        <record id="account.account_invoices" model="ir.actions.report">
            <field name="report_name">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="report_file">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="paperformat_id" ref="hongsar_reports.paperformat_hongsar_formal"/>
        </record>

        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="report_name">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="report_file">hongsar_reports.report_invoice_document_hongsar</field>
            <field name="paperformat_id" ref="hongsar_reports.paperformat_hongsar_formal"/>
        </record>
    </data>
</odoo>
