<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="report_invoice_document_custom_layout" inherit_id="account.report_invoice_document">
            <!-- Disable external layout title rendering; we inject our own title below -->
            <xpath expr="//t[@t-set='layout_document_title']" position="replace">
                <t t-set="layout_document_title"></t>
            </xpath>
            <!-- Hide clipped default title and render a new aligned title -->
            <xpath expr="//div[contains(@class, 'oe_structure')][1]" position="before">
                <style>
                    .article > h2:first-of-type {
                        display: none !important;
                    }
                </style>
            </xpath>
            <!-- Customer beside invoice date in #informations -->
            <xpath expr="//div[@name='invoice_date']" position="after">
                <div class="col" name="informations_customer">
                    <strong>Customer</strong>
                    <address class="mb-0" t-field="o.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                    <div t-if="o.partner_id.vat" class="mb-0">
                        <t t-if="o.company_id.account_fiscal_country_id.vat_label" t-out="o.company_id.account_fiscal_country_id.vat_label"/>
                        <t t-else="">Tax ID</t>: <span t-field="o.partner_id.vat"/>
                    </div>
                </div>
            </xpath>
            <xpath expr="//div[@id='informations']" position="before">
                <h2 style="display:block; width:100%; text-align:left; margin-left:4mm; margin-top:0; margin-bottom:1mm;">
                    <span t-if="not proforma and o.move_type == 'out_invoice' and o.state == 'posted'">Invoice </span>
                    <span t-elif="not proforma and o.move_type == 'out_invoice' and o.state == 'draft'">Draft Invoice </span>
                    <span t-elif="not proforma and o.move_type == 'out_invoice' and o.state == 'cancel'">Cancelled Invoice </span>
                    <span t-elif="not proforma and o.move_type == 'out_refund' and o.state == 'posted'">Credit Note </span>
                    <span t-elif="not proforma and o.move_type == 'out_refund' and o.state == 'draft'">Draft Credit Note </span>
                    <span t-elif="not proforma and o.move_type == 'out_refund' and o.state == 'cancel'">Cancelled Credit Note </span>
                    <span t-elif="not proforma and o.move_type == 'in_refund'">Vendor Credit Note </span>
                    <span t-elif="not proforma and o.move_type == 'in_invoice'">Vendor Bill </span>
                    <span t-else="">PROFORMA </span>
                    <span t-field="o.name"/>
                </h2>
            </xpath>
            <!-- Keep table header on every page and reduce row splitting -->
            <xpath expr="//table[@name='invoice_line_table']/thead" position="attributes">
                <attribute name="style">display: table-header-group;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']" position="attributes">
                <attribute name="class">o_has_total_table table o_main_table invoice_main_table table-borderless</attribute>
            </xpath>

            <xpath expr="//tbody[contains(@class, 'invoice_tbody')]//tr[.//td[@name='account_invoice_line_name']]" position="attributes">
                <attribute name="style">page-break-inside: auto; break-inside: auto;</attribute>
            </xpath>

            <xpath expr="//td[@name='account_invoice_line_name']" position="attributes">
                <attribute name="style">white-space: normal; word-break: break-word; overflow-wrap: anywhere;</attribute>
            </xpath>

            <!-- Product (Other Name) column -->
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="after">
                <th name="th_other_name" class="text-start"><span>Other Name</span></th>
            </xpath>
            <xpath expr="//td[@name='account_invoice_line_name']" position="after">
                <td name="td_other_name" class="text-start">
                    <span t-out="line.product_id.product_tmpl_id.product_other_name or '-'"/>
                </td>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_description']" position="attributes">
                <attribute name="style">width: 30%; white-space: normal;</attribute>
            </xpath>
            <xpath expr="//table[@name='invoice_line_table']//th[@name='th_other_name']" position="attributes">
                <attribute name="style">width: 14%; white-space: normal;</attribute>
            </xpath>
            <xpath expr="//td[@name='td_other_name']" position="attributes">
                <attribute name="style">white-space: normal; word-break: break-word; overflow-wrap: anywhere;</attribute>
            </xpath>

            <!-- Restore invoice table top border (sale-specific global CSS was removing it) -->
            <xpath expr="//div[contains(@class, 'page')]" position="inside">
                <style>
                    .invoice_main table[name="invoice_line_table"] {
                        border-top: 0.30mm solid #111 !important;
                        border-collapse: separate !important;
                        border-spacing: 0 !important;
                    }
                    .invoice_main table[name="invoice_line_table"] thead th {
                        border-top: 0 !important;
                    }
                </style>
            </xpath>

            <!-- Payment status as centered bold footer text at page end -->
            <xpath expr="//div[@id='payment_term']" position="after">
                <div class="text-center fw-bold mt-3 mb-1" name="payment_status_footer_center" style="clear: both; width: 100%;">
                    <span>PAYMENT STATUS: </span>
                    <span t-if="o.payment_state == 'paid'">PAID</span>
                    <span t-elif="o.payment_state == 'partial'">PARTIALLY PAID</span>
                    <span t-elif="o.payment_state == 'in_payment'">IN PAYMENT</span>
                    <span t-elif="o.payment_state == 'not_paid'">NOT PAID</span>
                    <span t-elif="o.payment_state == 'reversed'">REVERSED</span>
                    <span t-elif="o.payment_state == 'invoicing_legacy'">INVOICING LEGACY</span>
                    <span t-else="" t-out="o.payment_state"/>
                    <t t-if="o.amount_residual and o.move_type in ('out_invoice', 'out_refund')">
                        <span> - AMOUNT DUE: </span>
                        <span t-field="o.amount_residual"/>
                    </t>
                </div>
            </xpath>

        </template>
    </data>
</odoo>
