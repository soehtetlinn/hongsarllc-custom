<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_document_myanmar_fix" inherit_id="sale.report_saleorder_document">
        <!-- Disable external layout title rendering; we inject our own title below -->
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title"></t>
        </xpath>
        <!-- Hide clipped default title and render a new aligned title -->
        <xpath expr="//div[contains(@class, 'oe_structure')][1]" position="before">
            <style>
                .article > h2:first-of-type {
                    display: none !important;
                }
            </style>
        </xpath>
        <xpath expr="//div[@id='informations']" position="before">
            <h2 style="display:block; width:100%; text-align:left; margin-left:4mm; margin-top:0; margin-bottom:1mm;">
                <span t-if="is_proforma">Pro-Forma Invoice # </span>
                <span t-elif="doc.state in ['draft','sent']">Quotation # </span>
                <span t-else="">Order # </span>
                <span t-field="doc.name"/>
            </h2>
        </xpath>
        <!-- Customer beside order date in #informations (not separate address block) -->
        <xpath expr="//t[@t-set='address']" position="replace">
            <t t-set="address" t-value="False"/>
        </xpath>
        <xpath expr="//div[@id='informations']/div[@t-if='doc.user_id.name']" position="replace">
            <div t-if="doc.user_id.name" class="col" name="informations_salesperson">
                <strong>Salesperson</strong>
                <div t-field="doc.user_id"/>
            </div>
        </xpath>
        <xpath expr="//div[@name='informations_date']" position="after">
            <div class="col" name="informations_customer">
                <strong>Customer</strong>
                <div t-field="doc.partner_id" t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
                <p t-if="doc.partner_id.vat" class="mb-0">
                    <t t-if="doc.company_id.account_fiscal_country_id.vat_label" t-out="doc.company_id.account_fiscal_country_id.vat_label"/>
                    <t t-else="">Tax ID</t>: <span t-field="doc.partner_id.vat"/>
                </p>
            </div>
        </xpath>

        <!-- Product (Other Name) column -->
        <xpath expr="//th[@name='th_description']" position="after">
            <th name="th_other_name" class="text-start">Other Name</th>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="after">
            <td name="td_other_name" class="text-start">
                <span t-out="line.product_id.product_tmpl_id.product_other_name or '-'"/>
            </td>
        </xpath>

        <!-- Sale order lines: force packaging fields to appear as dedicated columns -->
        <xpath expr="//th[@name='th_description']" position="before">
            <th name="th_no" class="text-center">No.</th>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="before">
            <td name="td_no" class="text-center">
                <span t-out="line_index + 1"/>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="after">
            <th name="th_packaging_qty" class="text-end">Pkg.Qty</th>
            <th name="th_packaging" class="text-start">Pkg</th>
        </xpath>
        <xpath expr="//td[@name='td_quantity']/span[@t-if='line.product_packaging_id']" position="replace"/>
        <xpath expr="//td[@name='td_quantity']" position="after">
            <td name="td_packaging_qty" class="text-end">
                <span t-if="line.product_packaging_qty" t-field="line.product_packaging_qty" t-options='{"widget": "integer"}'/>
                <span t-else="">-</span>
            </td>
            <td name="td_packaging" class="text-start">
                <span t-if="line.product_packaging_id" t-field="line.product_packaging_id"/>
                <span t-else="">-</span>
            </td>
        </xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace"/>
        <xpath expr="//td[@name='td_taxes']" position="replace"/>
        <!-- Repeat SO table header on each new page -->
        <xpath expr="//table[contains(@class, 'o_main_table')]/thead" position="attributes">
            <attribute name="style">display: table-header-group;</attribute>
        </xpath>
        <!-- Avoid splitting one product line row between pages + keep visible row border -->
        <xpath expr="//tbody[contains(@class, 'sale_tbody')]//tr[.//td[@name='td_name']]" position="attributes">
            <attribute name="style">page-break-inside: auto; break-inside: auto; border-bottom: 1px solid #222;</attribute>
        </xpath>
        <!-- Prevent layout break: keep wrapping rules on description cells (no table-layout fixed) -->
        <xpath expr="//th[@name='th_description']" position="attributes">
            <attribute name="style">width: 28%; white-space: normal;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_other_name']" position="attributes">
            <attribute name="style">width: 12%; white-space: normal;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_no']" position="attributes">
            <attribute name="style">width: 6%;</attribute>
        </xpath>
        <xpath expr="//td[@name='td_name']" position="attributes">
            <attribute name="style">white-space: normal; word-break: break-word; overflow-wrap: anywhere;</attribute>
        </xpath>
        <xpath expr="//td[@name='td_other_name']" position="attributes">
            <attribute name="style">white-space: normal; word-break: break-word; overflow-wrap: anywhere;</attribute>
        </xpath>
        <!-- If a note line comes AFTER a product line, show it above that product line (and hide the standalone note row) -->
        <xpath expr="//td[@name='td_name']/span[@t-field='line.name']" position="before">
            <t t-if="not line_last and lines_to_report[line_index+1].display_type == 'line_note'">
                <div class="fst-italic o_line_note" style="margin-bottom: 1mm;">
                    <span t-field="lines_to_report[line_index+1].name"/>
                </div>
            </t>
        </xpath>
        <xpath expr="//td[@name='td_note_line']" position="attributes">
            <attribute name="t-if">not (line_index and (not lines_to_report[line_index-1].display_type) and lines_to_report[line_index-1].product_type != 'combo')</attribute>
            <attribute name="style">border-bottom: 1px solid #222;</attribute>
        </xpath>
        <!-- Remove section subtotal row from SO lines table (prevents subtotal appearing with notes) -->
        <xpath expr="//tr[contains(@class, 'is-subtotal')]" position="replace"/>
        <xpath expr="//th[@name='th_quantity']" position="attributes">
            <attribute name="style">width: 11%;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_quantity']" position="replace">
            <th name="th_quantity" class="text-end text-nowrap" style="width: 11%;">Qty</th>
        </xpath>
        <xpath expr="//th[@name='th_packaging_qty']" position="attributes">
            <attribute name="style">width: 10%;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_packaging']" position="attributes">
            <attribute name="style">width: 13%; white-space: normal;</attribute>
        </xpath>
        <xpath expr="//th[@name='th_subtotal']" position="attributes">
            <attribute name="style">width: 12%;</attribute>
        </xpath>
        <!-- Better visual ending before totals + cleaner totals placement -->
        <xpath expr="//table[contains(@class, 'o_main_table')]" position="attributes">
            <attribute name="class">o_has_total_table table o_main_table sale_main_table table-borderless</attribute>
            <attribute name="style">border-bottom: 1px solid #111; margin-bottom: 0; border-collapse: separate; border-spacing: 0;</attribute>
        </xpath>
        <xpath expr="//div[@id='total']" position="attributes">
            <attribute name="class">row mt-2</attribute>
            <attribute name="style">page-break-inside: avoid; break-inside: avoid;</attribute>
        </xpath>
    </template>
</odoo>
