<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Odoo 18: web.report_assets_common is an assets bundle (manifest), not a QWeb
        template — inherit_id="web.report_assets_common" will fail on install.
        Load our CSS via report_layout (PDF/HTML reports) and manifest assets (bundle).
    -->
    <template id="report_assets_common_myanmar" inherit_id="web.report_layout">
        <xpath expr="//t[@t-call-assets='web.report_assets_common']" position="after">
            <link rel="stylesheet"
                  type="text/css"
                  href="/hongsar_org_reports_fix_mod/static/src/css/org_reports_fix.css"/>
        </xpath>
    </template>

    <template id="report_preview_assets_myanmar" inherit_id="web.report_preview_layout">
        <xpath expr="//t[@t-call-assets='web.report_assets_common']" position="after">
            <link rel="stylesheet"
                  type="text/css"
                  href="/hongsar_org_reports_fix_mod/static/src/css/org_reports_fix.css"/>
        </xpath>
    </template>
</odoo>
